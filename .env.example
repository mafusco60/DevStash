# Copy this file to .env and fill in real values.
# Both .env and .env.local are gitignored.

# Neon Postgres — dev branch connection string.
# Get it from https://console.neon.tech → Project → Branches → Connection details.
DATABASE_URL="postgres://USER:PASSWORD@HOST/DBNAME?sslmode=verify-full&channel_binding=require"

# Optional: separate shadow database for `prisma migrate dev` if your provider
# does not allow ephemeral databases. Neon Postgres handles shadows automatically,
# so this is usually not required.
# SHADOW_DATABASE_URL=""

# Context7 MCP server API key — used by .mcp.json for the context7 server.
# Get it from https://context7.com.
# Note: Claude Code reads this from the shell environment at launch, not from
# .env files. Source .env.local before running `claude`, or export it from
# ~/.zshrc.
CONTEXT7_API_KEY="ctx7sk-..."

# NextAuth v5 — used to sign JWTs and validate sessions.
# Generate with `npx auth secret` (or `openssl rand -base64 32`).
AUTH_SECRET=""

# GitHub OAuth app credentials for NextAuth's GitHub provider.
# Create at https://github.com/settings/developers → New OAuth App.
# Authorization callback URL (dev): http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Resend — transactional email (verification, password reset, …).
# Get an API key at https://resend.com/api-keys.
# Dev sender `onboarding@resend.dev` only delivers to the Resend account owner.
# In production, set EMAIL_FROM to a verified-domain address.
RESEND_API_KEY=""
EMAIL_FROM="DevStash <onboarding@resend.dev>"

# Public base URL used to build email links (e.g. the verification URL).
# Local dev: http://localhost:3000  •  Prod: your deployed origin.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Toggle the email verification flow. Default (unset / any value) is enabled.
# Set to "false", "0", or "off" to bypass: new users register pre-verified and
# the Resend email is skipped. Dev/testing convenience only — keep enabled in
# production so unverified emails can't sign in.
EMAIL_VERIFICATION_ENABLED="true"
