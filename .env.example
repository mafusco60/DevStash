# Copy this file to .env and fill in real values.
# Both .env and .env.local are gitignored.

# Neon Postgres — dev branch connection string.
# Get it from https://console.neon.tech → Project → Branches → Connection details.
DATABASE_URL="postgres://USER:PASSWORD@HOST/DBNAME?sslmode=verify-full&channel_binding=require"

# Optional: separate shadow database for `prisma migrate dev` if your provider
# does not allow ephemeral databases. Neon Postgres handles shadows automatically,
# so this is usually not required.
# SHADOW_DATABASE_URL=""
